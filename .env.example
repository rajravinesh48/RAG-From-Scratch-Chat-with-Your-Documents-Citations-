# Flask
FLASK_SECRET_KEY=replace-with-a-random-secret

# Default answer generator.
# Ollama is optional; the project also has a local extractive fallback.
LLM_PROVIDER=ollama

# Optional local Ollama
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=120

# Optional Gemini cloud generator
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TIMEOUT=45

# Optional GitHub-backed storage for a hosted demo.
# These are not required for the core assignment.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_DOCUMENTS_PATH=documents
DOCUMENTS_DIR=documents
