import json
from pathlib import Path

from flask import Flask, request, render_template_string, redirect, url_for, session, make_response
from werkzeug.utils import secure_filename

from ingest import ingest_documents
from retriever import retrieve_relevant_chunks
from generator import generate_answer


app = Flask(__name__)
app.secret_key = "rag_demo_secret_key"

DOCUMENTS_DIR = Path("documents")
VECTOR_STORE_FILE = Path("vector_store/store.json")

ALLOWED_EXTENSIONS = {".pdf", ".txt", ".docx"}


def load_vector_store():
    if not VECTOR_STORE_FILE.exists():
        return None, None, None

    with open(VECTOR_STORE_FILE, "r", encoding="utf-8") as file:
        data = json.load(file)

    vocabulary = data["vocabulary"]
    idf_values = data.get("idf_values")
    chunks = data["chunks"]

    return vocabulary, idf_values, chunks

def is_allowed_file(filename):
    extension = Path(filename).suffix.lower()
    return extension in ALLOWED_EXTENSIONS


def get_documents():
    DOCUMENTS_DIR.mkdir(exist_ok=True)

    files = []

    for file_path in DOCUMENTS_DIR.iterdir():
        if file_path.is_file() and is_allowed_file(file_path.name):
            files.append(file_path.name)

    return sorted(files)


def get_store_stats():
    vocabulary, idf_values, chunks = load_vector_store()

    if vocabulary is None or chunks is None:
        return {
            "status": "Not created",
            "total_chunks": 0,
            "vocabulary_size": 0,
            "document_count": len(get_documents())
        }

    return {
        "status": "Ready",
        "total_chunks": len(chunks),
        "vocabulary_size": len(vocabulary),
        "document_count": len(get_documents())
    }


def get_confidence(score):
    if score >= 0.30:
        return "High"
    elif score >= 0.10:
        return "Medium"
    elif score > 0:
        return "Low"
    else:
        return "No Match"


