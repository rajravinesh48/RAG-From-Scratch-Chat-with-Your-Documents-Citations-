@app.route("/", methods=["GET", "POST"])
def home():
    question = ""
    message = request.args.get("message")
    error = request.args.get("error")

    if "chat_history" not in session:
        session["chat_history"] = []

    if request.method == "POST":
        question = request.form.get("question", "").strip()

        if not question:
            error = "Please enter a question."
        else:
            vocabulary, idf_values, embedded_chunks = load_vector_store()

            if vocabulary is None or embedded_chunks is None:
                error = "Vector store not found. Please upload documents or run python ingest.py."
            else:
                relevant_chunks = retrieve_relevant_chunks(
                    question=question,
                    embedded_chunks=embedded_chunks,
                    vocabulary=vocabulary,
                    idf_values=idf_values,
                    top_k=3,
                    min_score=0.01
                )

                answer = generate_answer(question, relevant_chunks)

                top_score = 0
                if relevant_chunks:
                    top_score = relevant_chunks[0]["score"]

                confidence = get_confidence(top_score)

                sources = []

                for chunk in relevant_chunks:
                    if chunk["score"] > 0:
                        sources.append({
                            "filename": chunk["filename"],
                            "chunk_id": chunk["chunk_id"],
                            "score": round(chunk["score"], 4),
                            "matched_keywords": ", ".join(chunk.get("matched_keywords", [])),
                            "text": chunk["text"]
                        })

                chat_history = session.get("chat_history", [])
                chat_history.append({
                    "question": question,
                    "answer": answer,
                    "confidence": confidence,
                    "sources": sources
                })

                session["chat_history"] = chat_history

    return render_template_string(
        HTML_PAGE,
        question=question,
        chat_history=session.get("chat_history", []),
        documents=get_documents(),
        stats=get_store_stats(),
        message=message,
        error=error
    )


@app.route("/upload", methods=["POST"])
def upload_document():
    if "document" not in request.files:
        return redirect(url_for("home", error="No file selected."))

    file = request.files["document"]

    if file.filename == "":
        return redirect(url_for("home", error="No file selected."))

    if not is_allowed_file(file.filename):
        return redirect(url_for("home", error="Only PDF, TXT and DOCX files are supported."))

    DOCUMENTS_DIR.mkdir(exist_ok=True)

    filename = secure_filename(file.filename)
    save_path = DOCUMENTS_DIR / filename
    file.save(save_path)

    try:
        ingest_documents()
    except Exception as e:
        return redirect(url_for("home", error=f"File uploaded but vector store failed: {str(e)}"))

    return redirect(url_for("home", message="Document uploaded and vector store rebuilt successfully."))


@app.route("/delete/<filename>", methods=["POST"])
def delete_document(filename):
    safe_filename = secure_filename(filename)
    file_path = DOCUMENTS_DIR / safe_filename

    if file_path.exists():
        file_path.unlink()

        try:
            ingest_documents()
        except Exception as e:
            return redirect(url_for("home", error=f"Document deleted but vector store rebuild failed: {str(e)}"))

        return redirect(url_for("home", message="Document deleted and vector store rebuilt successfully."))

    return redirect(url_for("home", error="Document not found."))


@app.route("/rebuild", methods=["POST"])
def rebuild_store():
    try:
        ingest_documents()
    except Exception as e:
        return redirect(url_for("home", error=f"Vector store rebuild failed: {str(e)}"))

    return redirect(url_for("home", message="Vector store rebuilt successfully."))


@app.route("/clear", methods=["POST"])
def clear_chat():
    session["chat_history"] = []
    return redirect(url_for("home", message="Chat cleared."))


@app.route("/download-chat", methods=["POST"])
def download_chat():
    chat_history = session.get("chat_history", [])

    content = "RAG Chat History\n"
    content += "=" * 50 + "\n\n"

    if not chat_history:
        content += "No chat history available.\n"
    else:
        for index, chat in enumerate(chat_history, start=1):
            content += f"Question {index}:\n"
            content += chat["question"] + "\n\n"
            content += "Answer:\n"
            content += chat["answer"] + "\n"
            content += "-" * 50 + "\n\n"

    response = make_response(content)
    response.headers["Content-Disposition"] = "attachment; filename=rag_chat_history.txt"
    response.headers["Content-Type"] = "text/plain"

    return response


if __name__ == "__main__":
    app.run(debug=True)